-- INNER JOIN
SELECT c.nombre, p.id_pedido
FROM clientes c
INNER JOIN pedidos p ON c.id_cliente = p.id_cliente;

SELECT pr.nombre, d.cantidad
FROM productos pr
INNER JOIN detalle_pedido d ON pr.id_producto = d.id_producto;