CREATE DATABASE vuelos;
GO
USE vuelos;

-- TABLAS
CREATE TABLE aerolineas (
    id_aerolinea INT IDENTITY PRIMARY KEY,
    nombre VARCHAR(50)
);

CREATE TABLE aviones (
    id_avion INT IDENTITY PRIMARY KEY,
    modelo VARCHAR(50),
    id_aerolinea INT FOREIGN KEY REFERENCES aerolineas(id_aerolinea)
);

CREATE TABLE pasajeros (
    id_pasajero INT IDENTITY PRIMARY KEY,
    nombre VARCHAR(50)
);

CREATE TABLE vuelos (
    id_vuelo INT IDENTITY PRIMARY KEY,
    id_avion INT FOREIGN KEY REFERENCES aviones(id_avion),
    fecha DATE
);

CREATE TABLE reservas (
    id_reserva INT IDENTITY PRIMARY KEY,
    id_pasajero INT FOREIGN KEY REFERENCES pasajeros(id_pasajero),
    id_vuelo INT FOREIGN KEY REFERENCES vuelos(id_vuelo)
);

