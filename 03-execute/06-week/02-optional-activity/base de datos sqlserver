-- SELECT
SELECT * FROM aerolineas WHERE nombre LIKE 'A%';
SELECT * FROM aerolineas WHERE nombre LIKE '%a%';

SELECT * FROM pasajeros WHERE nombre LIKE 'J%';
SELECT * FROM pasajeros WHERE nombre LIKE '%a%';

SELECT * FROM vuelos WHERE fecha > '2024-01-02';
SELECT * FROM vuelos WHERE id_avion=1;

-- INNER JOIN
SELECT a.nombre, v.fecha
FROM aerolineas a
INNER JOIN aviones av ON a.id_aerolinea = av.id_aerolinea
INNER JOIN vuelos v ON av.id_avion = v.id_avion;

SELECT p.nombre, r.id_reserva
FROM pasajeros p
INNER JOIN reservas r ON p.id_pasajero = r.id_pasajero;