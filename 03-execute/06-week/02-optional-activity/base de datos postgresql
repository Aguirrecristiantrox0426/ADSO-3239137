-- SELECT
SELECT * FROM autores WHERE nombre LIKE 'G%';
SELECT * FROM autores WHERE nombre LIKE '%a%';

SELECT * FROM libros WHERE titulo LIKE '%o%';
SELECT * FROM libros WHERE id_autor=1;

SELECT * FROM usuarios WHERE nombre LIKE 'C%';
SELECT * FROM usuarios WHERE nombre LIKE '%a%';

SELECT * FROM prestamos WHERE fecha > '2024-01-02';
SELECT * FROM prestamos WHERE id_usuario=1;

SELECT * FROM detalle_prestamo WHERE id_libro=1;
SELECT * FROM detalle_prestamo WHERE id_prestamo=2;

-- INNER JOIN
SELECT l.titulo, a.nombre
FROM libros l
INNER JOIN autores a ON l.id_autor = a.id_autor;

SELECT u.nombre, p.fecha
FROM usuarios u
INNER JOIN prestamos p ON u.id_usuario = p.id_usuario;